# Copy to .env (or run: python scripts/generate_env.py) and replace every "change-me" value.
# .env is listed in .gitignore and must never be committed.

# ---- serving database (delivery to the ML application)
SERVING_ADMIN_PASSWORD=change-me
SERVING_ETL_PASSWORD=change-me
SERVING_ML_PASSWORD=change-me

# ---- Airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Fernet key: 32 url-safe base64-encoded bytes (generate_env.py creates one)
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# ---- optional: download the dataset from Kaggle instead of Zenodo
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- resources (lower these on a laptop with 8 GB RAM, see README)
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MEMORY=1g

# ---- pipeline
PIPELINE_FIRST_MONTH=2005-06
PIPELINE_LAST_MONTH=2006-01
MAX_MALFORMED_RATIO=0.01
