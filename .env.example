# Copy this file to .env and change EVERY value before the first start.
# .env is listed in .gitignore and never goes to Git.

# Serving database (features + audit tables)
SERVING_DB_ADMIN_PASSWORD=change-me-1
PIPELINE_WRITER_PASSWORD=change-me-2
ML_READER_PASSWORD=change-me-3
DASHBOARD_READER_PASSWORD=change-me-4

# Airflow
AIRFLOW_DB_PASSWORD=change-me-5
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-6
# Any long random text, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change-me-to-a-long-random-text
