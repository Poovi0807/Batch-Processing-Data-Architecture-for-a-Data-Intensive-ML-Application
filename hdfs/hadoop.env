# Hadoop configuration, converted to core-site.xml / hdfs-site.xml by the
# official apache/hadoop image at start-up (format: FILE.XML_property=value).

CORE-SITE.XML_fs.defaultFS=hdfs://hdfs-namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=hdfs-namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
# every block is stored on both DataNodes
HDFS-SITE.XML_dfs.replication=2
# file permissions are enforced (data-lake zones belong to user "etl")
HDFS-SITE.XML_dfs.permissions.enabled=true
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# containers have no reverse DNS entries by default
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
